# WARNING: Read docs/repos.md for instructions on how to update this file
# WARNING: If you change the baseurls in this file, then you need to update the
# corresponding `content_sets-rhel-VERSION.yaml` file.

[rhel-9.8-baseos]
name=rhel-9.8-baseos
baseurl=https://download.devel.redhat.com/rhel-9/nightly/RHEL-9/latest-RHEL-9.8/compose/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

[rhel-9.8-appstream]
name=rhel-9.8-appstream
baseurl=https://download.devel.redhat.com/rhel-9/nightly/RHEL-9/latest-RHEL-9.8/compose/AppStream/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
# We want to pull toolbox from RHAOS repos for now
# https://issues.redhat.com/browse/OCPBUGS-56600
excludepkgs=toolbox*

[rhel-9.8-nfv]
name=rhel-9.8-nfv
baseurl=https://download.devel.redhat.com/rhel-9/nightly/RHEL-9/latest-RHEL-9.8/compose/NFV/$basearch/os/
# this one isn't necessary for the base compose and isn't available on all arches
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

[rhel-9.8-highavailability]
name=rhel-9.8-highavailability
baseurl=https://download.devel.redhat.com/rhel-9/nightly/RHEL-9/latest-RHEL-9.8/compose/HighAvailability/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

[rhel-9.8-fast-datapath]
name=rhel-9.8-fast-datapath
# NOTE this one uses the latest major GA content
baseurl=https://download.devel.redhat.com/rhel-9/nightly/RHEL-9/latest-RHEL-9.8/compose/Fast-Datapath/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

# In the el-only variants, we still want the early kernels. Currently
# those are just part of the plashets, which are OCP-versioned. In
# https://issues.redhat.com/browse/ART-11248, we've agreed for now that
# instead of having a separate RHEL-only repo, we'll just reuse a plashet repo
# and filter out everything *but* the kernel. We just need to make sure to
# use a plashet of an OCP version we know is based on the RHEL version we're
# interested in.
[rhel-9.8-early-kernel]
name=rhel-9.8-early-kernel
baseurl=https://ocp-artifacts.engineering.redhat.com/pub/RHOCP/plashets/4.22/stream/el9/latest/$basearch/os
# - Also include the legacy toolbox package until we move to the new containers one
#   https://docs.google.com/document/d/137krt0IRctfwf2e7k1r7tKYPysWrDlTxqdFhFA9XKbw/edit?tab=t.0#heading=h.slko10np055j
#   https://issues.redhat.com/browse/OCPBUGS-56600
includepkgs=kernel,kernel-*,toolbox*,
enabled=1
# ART RPMs are not signed before GA
gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

